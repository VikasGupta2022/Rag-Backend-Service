# ==========================================
# RAG Backend Service Configuration
# ==========================================

# Application
PROJECT_NAME="High-Performance RAG Backend"
API_V1_PREFIX="/api/v1"
DEBUG=false
API_KEY="" # Optional: Set to enforce X-API-Key header authentication

# Google Gemini Configuration
# Paste your Gemini API Key from Google AI Studio here
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSION=768

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# Hybrid Search RRF Weights
RRF_K=60
DENSE_TOP_K=10
SPARSE_TOP_K=10
FINAL_TOP_K=5
